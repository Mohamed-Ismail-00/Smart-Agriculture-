# Same-origin API (served behind nginx / the bundled backend). Set a full URL
# here only when the frontend is hosted separately from the backend.
VITE_API_BASE_URL=/api/v1
# Web client ID from your own Google Cloud project (empty = Google Sign-In disabled)
VITE_GOOGLE_CLIENT_ID=
# Firebase Web client used as native Android serverClientId (must also be listed in backend GOOGLE_CLIENT_IDS)
VITE_GOOGLE_NATIVE_CLIENT_ID=
