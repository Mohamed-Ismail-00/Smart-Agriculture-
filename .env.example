# Template for the two local env files docker-compose.yml expects.
# Copy the sections below into `.env.db` and `.env.backend` at the project root
# and replace every CHANGE_ME value. Neither file is committed.

# ----------------------------------------------------------------------------
# .env.db
# ----------------------------------------------------------------------------
POSTGRES_USER=agri_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=agriculture

# ----------------------------------------------------------------------------
# .env.backend
# ----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Database (must match .env.db)
POSTGRES_USER=agri_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agriculture
DATABASE_URL=postgresql+psycopg2://agri_user:CHANGE_ME@postgres:5432/agriculture

# Auth / encryption
# SECRET_KEY: any long random string
# ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin account created on first backend startup (registration cannot create admins)
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# CORS (empty = allow all, dev only)
CORS_ORIGINS=

# Google sign-in (optional; must match VITE_GOOGLE_CLIENT_ID in the frontend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Storage
IMAGES_DIR=/data/images

# Scheduler
LAND_MONITOR_INTERVAL_MINUTES=1440
AI_AUTO_ANALYZE_HOURS=6
AI_INSIGHT_STALE_HOURS=24
