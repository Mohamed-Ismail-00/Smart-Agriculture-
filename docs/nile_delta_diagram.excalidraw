   "roundness": null,
   "seed": 1112,
   "version": 1,
   "versionNonce": 5112,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Time series: one pixel's values over time\n\nLabel: the true crop name\n\nSample: one pixel in one season\n\nmacro-F1: average score over all crops\n\nL2A: images corrected for the atmosphere",
   "originalText": "Time series: one pixel's values over time\n\nLabel: the true crop name\n\nSample: one pixel in one season\n\nmacro-F1: average score over all crops\n\nL2A: images corrected for the atmosphere",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
