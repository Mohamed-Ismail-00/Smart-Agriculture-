  {
   "id": "el111",
   "type": "text",
   "x": 1708,
   "y": 826,
   "width": 400,
   "height": 180.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
