   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1111,
   "version": 1,
   "versionNonce": 5111,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Pixel: one 10 m square of land\n\nBand: one colour the satellite measures\n\nNIR: light that healthy leaves reflect\n\nNDVI: greenness index, from -1 to 1\n\nDekad: a period of 10 days",
   "originalText": "Pixel: one 10 m square of land\n\nBand: one colour the satellite measures\n\nNIR: light that healthy leaves reflect\n\nNDVI: greenness index, from -1 to 1\n\nDekad: a period of 10 days",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
  },
  {
   "id": "el112",
